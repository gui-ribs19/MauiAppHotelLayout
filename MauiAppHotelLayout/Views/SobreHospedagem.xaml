<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelLayout.Views.SobreHospedagem"
             Title="SobreHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout 
        VerticalOptions="CenterAndExpand"
        Padding="20"
        Spacing="25">


        <!-- Titulo -->
        <Label Text="Sobre Hospedagem"
               FontFamily="Satisfy-Regular"
               FontSize="50"
               TextColor="{StaticResource Primary}" />

        <!-- QUADRO PRETO -->
        <Border
            BackgroundColor="Black"
            StrokeThickness="0"
            Padding="25"
            StrokeShape="RoundRectangle 30">

            <VerticalStackLayout
                Spacing="20"
                HorizontalOptions="Center">


                <!-- Imagem Do Desenvolvedor -->
                <Frame
                WidthRequest="150"
                HeightRequest="150"
                CornerRadius="100"
                Padding="0"
                IsClippedToBounds="True"
                HorizontalOptions="Center">

                    <Image 
                    Source="foto_profissional.jpg"
                    Aspect="AspectFill"/>

                </Frame>

                <!-- Nome DO Desenvolvedor -->
                <Label 
               Text="Dev:Guilherme Souza Ribeiro"
               FontSize="24"
               HorizontalOptions="Center"
               FontFamily="Satisfy-Regular"           
               TextColor="{StaticResource Primary}" />

                <!-- Espaço -->
                <Label 
                    Text="" />
                <Label 
                    Text="" />

                <!-- Data -->
                <Label 
                    Text="Criado em 17/05/2026" 
                    FontSize="13"
                    HorizontalOptions="Center"
                    TextColor="{StaticResource Primary}"/>

            </VerticalStackLayout>

        </Border>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
    
</ContentPage>